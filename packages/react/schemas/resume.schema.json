{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalaa.buildwithshashank.com/schemas/resume.schema.json",
  "title": "ResumeData",
  "description": "Data-first resume schema for @kalaa/react ResumePage and resume blocks.",
  "type": "object",
  "required": ["basics", "summary", "experience", "education", "skills"],
  "additionalProperties": false,
  "properties": {
    "basics": {
      "type": "object",
      "required": ["name", "title"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "org", "startDate", "bullets"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "org": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "startDate": { "type": "string", "minLength": 1 },
          "endDate": { "type": "string" },
          "summary": { "type": "string" },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["degree", "institution", "endDate"],
        "additionalProperties": false,
        "properties": {
          "degree": { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string", "minLength": 1 },
          "details": { "type": "string" },
          "honors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "skills"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "impact": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "href"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "href": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "issuer", "date"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "expiryDate": { "type": "string" },
          "credentialId": { "type": "string" },
          "href": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "proficiency"],
        "additionalProperties": false,
        "properties": {
          "language": { "type": "string", "minLength": 1 },
          "proficiency": { "type": "string", "minLength": 1 },
          "level": {
            "type": "string",
            "enum": ["native", "fluent", "professional", "elementary"]
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "issuer", "date"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["award", "publication"] },
          "summary": { "type": "string" },
          "href": { "type": "string" }
        }
      }
    }
  }
}
