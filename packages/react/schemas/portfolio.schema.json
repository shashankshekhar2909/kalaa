{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalaa.buildwithshashank.com/schemas/portfolio.schema.json",
  "title": "PortfolioData",
  "description": "Data-first portfolio schema for @kalaa/react PortfolioPage and profile blocks.",
  "type": "object",
  "required": ["profile", "caseStudies", "contact", "footer"],
  "additionalProperties": false,
  "properties": {
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "role", "bio"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "bio": { "type": "string", "minLength": 1 },
        "availability": { "type": "string" },
        "initials": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" }
            }
          }
        },
        "primaryAction": {
          "type": "object",
          "required": ["label", "href"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "minLength": 1 }
          }
        },
        "secondaryAction": {
          "type": "object",
          "required": ["label", "href"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "caseStudies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "year", "summary"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "client": { "type": "string" },
          "year": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "challenge": { "type": "string" },
          "outcome": { "type": "string" },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "href": { "type": "string" },
          "ctaLabel": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "impact": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "href"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "href": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "minLength": 1 },
          "endDate": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "description": { "type": "string" },
          "badge": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "skills"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quote", "author", "role"],
        "additionalProperties": false,
        "properties": {
          "quote": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "org": { "type": "string" },
          "date": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "meta": { "type": "string" }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "email": { "type": "string", "minLength": 1 },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "availability": { "type": "string" },
        "responseTime": { "type": "string" },
        "ctaLabel": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "required": ["brandName"],
      "additionalProperties": false,
      "properties": {
        "brandName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["heading", "links"],
            "additionalProperties": false,
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "href"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "href": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 }
            }
          }
        },
        "copyright": { "type": "string" },
        "showLogo": { "type": "boolean" }
      }
    }
  }
}
