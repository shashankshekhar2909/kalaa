{
  "name": "@kalaa/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && cp src/styles.css dist/styles.css",
    "check": "tsc --noEmit"
  }
}
