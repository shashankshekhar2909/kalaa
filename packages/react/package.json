{
  "name": "@kalaa/react",
  "version": "0.3.2",
  "description": "Accessible React component library, design blocks and page templates styled with Kalaa tokens.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://kalaa.buildwithshashank.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankshekhar2909/kalaa.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/shashankshekhar2909/kalaa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "accessible",
    "wcag",
    "base-ui",
    "kalaa"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "files": [
    "dist",
    "schemas",
    "components.json",
    "llms.txt"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./resume.schema.json": "./schemas/resume.schema.json",
    "./portfolio.schema.json": "./schemas/portfolio.schema.json",
    "./schemas/resume.schema.json": "./schemas/resume.schema.json",
    "./schemas/portfolio.schema.json": "./schemas/portfolio.schema.json",
    "./sample-resume.json": "./schemas/sample-resume.json",
    "./components.json": "./components.json",
    "./llms.txt": "./llms.txt"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/css.mjs && node scripts/ai-manifest.mjs",
    "check": "tsc --noEmit && node scripts/version.mjs && node scripts/css.mjs --check && node scripts/ai-manifest.mjs --check",
    "test": "vitest run"
  }
}
