{
  "name": "@kalaa/tokens",
  "version": "0.3.1",
  "description": "Design tokens, color roles, themes, and self-hosted IBM Plex typography for the Kalaa design system.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/theme.js",
    "**/theme-picker.js"
  ],
  "homepage": "https://kalaa.buildwithshashank.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankshekhar2909/kalaa.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/shashankshekhar2909/kalaa/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "dtcg",
    "style-dictionary",
    "ibm-plex",
    "wcag",
    "kalaa"
  ],
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "style-dictionary": "5.8.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./theme.js": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./theme-picker.js": {
      "types": "./dist/theme-picker.d.ts",
      "default": "./dist/theme-picker.js"
    },
    "./appearance-script": {
      "types": "./dist/appearance-script.d.ts",
      "import": "./dist/appearance-script.js"
    },
    "./appearance-script.js": {
      "types": "./dist/appearance-script.d.ts",
      "import": "./dist/appearance-script.js"
    }
  },
  "scripts": {
    "build": "node scripts/ramps.mjs && node build.mjs && node scripts/check-contrast.mjs",
    "check": "node scripts/check-contrast.mjs",
    "test": "node --test test/theme.test.mjs"
  }
}
