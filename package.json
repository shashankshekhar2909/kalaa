{
  "name": "kalaa",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "check": "pnpm -r run check",
    "storybook": "pnpm --filter @kalaa/storybook run dev",
    "build:site": "pnpm --filter @kalaa/site run build",
    "build-storybook": "pnpm --filter @kalaa/storybook run build",
    "test": "pnpm -r run test",
    "version-packages": "changeset version && node packages/react/scripts/version.mjs --write",
    "test:stories": "playwright test",
    "test:stories:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.65.1",
    "opentype.js": "2.0.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
